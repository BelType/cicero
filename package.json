{
  "name": "@beltype/cicero",
  "version": "0.1.7",
  "description": "Cicero, a paged-media engine for the live browser: it cuts a document into pages under CSS Paged Media and presents them as real frames. Beta.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BelType/cicero.git"
  },
  "homepage": "https://codeberg.org/BelType/cicero",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/seam/host.d.ts",
      "import": "./dist/seam/host.js"
    },
    "./engine": {
      "types": "./dist/seam/index.d.ts",
      "import": "./dist/seam/index.js"
    },
    "./flags": {
      "types": "./dist/seam/flags.d.ts",
      "import": "./dist/seam/flags.js"
    },
    "./rewrite": {
      "types": "./dist/seam/rewrite-document.d.ts",
      "import": "./dist/seam/rewrite-document.js"
    },
    "./facsimile": {
      "types": "./dist/seam/facsimile.d.ts",
      "import": "./dist/seam/facsimile.js"
    },
    "./client": {
      "types": "./dist/seam/client.d.ts",
      "import": "./dist/seam/client.js"
    },
    "./fragmentation": {
      "types": "./dist/src/fragmentation.d.ts",
      "import": "./dist/src/fragmentation.js"
    },
    "./page": {
      "types": "./dist/src/chase.d.ts",
      "import": "./dist/src/chase.js"
    },
    "./internal/*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.facsimile.json && node scripts/copy-assets.js",
    "check": "tsc -p tsconfig.test.json",
    "test": "node --test 'test/*.test.ts'",
    "test:browser": "node --test --test-concurrency=1 'test/browser/*.browser.ts'",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@beltype/common": "0.1.2",
    "css-tree": "^3.2.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.20.4",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@beltype/common"
    ]
  },
  "bugs": {
    "url": "https://codeberg.org/BelType/cicero/issues"
  }
}
