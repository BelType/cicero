{
  "name": "@beltype/cicero",
  "version": "0.1.0",
  "description": "Cicero, a paged-media engine for the live browser: it cuts a document into pages under CSS Paged Media and presents them as real frames. Beta.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/BelType/cicero.git"
  },
  "homepage": "https://codeberg.org/BelType/cicero",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/seam/host.d.ts",
      "import": "./dist/seam/host.js"
    },
    "./facsimile": {
      "types": "./dist/seam/facsimile.d.ts",
      "import": "./dist/seam/facsimile.js"
    },
    "./client": {
      "types": "./dist/seam/client.d.ts",
      "import": "./dist/seam/client.js"
    },
    "./fragmentation": {
      "types": "./dist/src/fragmentation.d.ts",
      "import": "./dist/src/fragmentation.js"
    },
    "./internal/*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.facsimile.json && node scripts/copy-assets.js",
    "check": "tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@beltype/common": "git+ssh://git@codeberg.org/BelType/common.git#v0.1.0",
    "css-tree": "^3.2.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.20.4",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@beltype/common"
    ]
  }
}
